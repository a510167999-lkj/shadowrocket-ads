#!name=开屏广告
#!desc=精简：百度地图/QQ音乐/B站/微博/淘宝。金融不解密不拦广告。
#!category=AdBlock

[Rule]
DOMAIN,tmead.y.qq.com,REJECT
DOMAIN,tmeadquic.y.qq.com,REJECT
DOMAIN,tmeadbak.y.qq.com,REJECT
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,adcdn6.tencentmusic.com,REJECT
DOMAIN,adexpo.tencentmusic.com,REJECT
DOMAIN,adclick.tencentmusic.com,REJECT
DOMAIN,adstats.tencentmusic.com,REJECT
DOMAIN,afd.baidu.com,REJECT
DOMAIN,nadvideo.baidu.com,REJECT
DOMAIN,nadvideo2.baidu.com,REJECT
DOMAIN,httpdns.baidubce.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT

[URL Rewrite]
^https?://(www.)?g.cn https://www.google.com 302
^https?://(www.)?google.cn https://www.google.com 302
^https?:\/\/(newclient\.map\.baidu\.com|180\.76\.76\.200)\/client\/phpui2?\/\?.*qt=(ads|ad|adv) - reject-200
^https?:\/\/newclient\.map\.baidu\.com\/client\/crossmarketing - reject-200
^https?:\/\/httpdns\.baidubce\.com - reject-200
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-200
^https?:\/\/tmead(quic|bak)?\.y\.qq\.com - reject-200
^https?:\/\/ad(cdn6?|expo|click|stats)?\.tencentmusic\.com - reject-200
^https?:\/\/us\.l\.qq\.com\/exapp - reject-200
^https?:\/\/httpdns\.n\.qq\.com - reject-200
^https?:\/\/y\.gtimg\.cn\/music\/common\/upload\/t_splash_info\/ - reject-200
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get - reject-200
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|list|brand) - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_positive - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/push\/info - reject-200
^https?:\/\/api\.weibo\.cn\/.*account\/recommend_interesttags - reject-200
^https?:\/\/api\.weibo\.cn\/.*\/media_homelist - reject-200
^https?:\/\/api\.weibo\.cn\/.*finder\/searchbarchange - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/ad\/preload - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/profile\/recommend_popuser - reject-200
^https?:\/\/boot.*weibo\.com\/v\d\/ad\/realtime - reject-200
^https?:\/\/api\.weibo\.cn\/.*discovery_home_bottom_getdotinfo - reject-200
^https?:\/\/m?api\.weibo\.c(n|om)\/\d/push/daily - reject-200
^https?:\/\/(preload-click|preload-impression)\.uve\.weibo\.com\/(interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua) - reject-200
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php - reject-200
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/hot\/hours_spotlight - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/cardlist\?v_f=.*Weibo_intl - reject-200
^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users - reject-200
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/ad\/weibointl\? - reject-200

[Script]
qqmusic_musicu = type=http-response,pattern=^https?:\/\/u\.y\.qq\.com\/cgi-bin\/musicu\.fcg,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/a510167999-lkj/shadowrocket-ads/main/scripts/qqmusic.ads.js,timeout=30
baidumap_ads = type=http-response,pattern=^https?:\/\/(newclient\.map\.baidu\.com|180\.76\.76\.200)\/client\/phpui2\/\?.*qt=ads,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/baidumap.js,timeout=30
bili_json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show)|feed\/index\?)|resource\/show\/tab\/v2),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/bilibili-json.js,timeout=30
bili_proto = type=http-response,pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(viewunite\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/bilibili-proto.js,timeout=30

[MITM]
hostname = %APPEND% newclient.map.baidu.com, 180.76.76.200, httpdns.baidubce.com, afd.baidu.com, u.y.qq.com, tmead.y.qq.com, tmeadquic.y.qq.com, httpdns.n.qq.com, y.gtimg.cn, us.l.qq.com, guide-acs.m.taobao.com, acs.m.taobao.com, app.bilibili.com, grpc.biliapi.net, api.biliapi.net, api.weibo.cn, *.api.weibo.cn, mapi.weibo.com, *.uve.weibo.com, boot.biz.weibo.com, weibointl.api.weibo.cn, sdkapp.uve.weibo.com
